# Copy to .env and fill in. Every key is optional - the system runs without any
# of them, with the affected agent degrading rather than failing.

# Real sportsbook lines for the Market Odds agent.
# Free tier (500 requests/month) at https://the-odds-api.com
# Without this the agent returns confidence 0.50 and contributes nothing.
ODDS_API_KEY=

# Optional. Open-Meteo and NOAA require no key, so the weather agent works
# without this. Only adds WeatherAPI.com as an extra fallback source.
WEATHER_API_KEY=

# Optional. Enables the sportsdata.io stats fallback in utils/api_clients.py.
# ESPN and Pro Football Reference are tried first and need no key.
NFL_API_KEY=
